# Mode 1: plain SQLite (default)
DATABASE_URL=sqlite:///./test.db

# Mode 2: local libSQL
# DATABASE_URL=sqlite+libsql:///local.db

# Mode 3: Turso remote
# DATABASE_URL=sqlite+libsql://<your-db>.turso.io?secure=true
# TURSO_AUTH_TOKEN=<token>

# Mode 4: Turso embedded replica
# DATABASE_URL=sqlite+libsql:///embedded.db
# TURSO_AUTH_TOKEN=<token>
# TURSO_SYNC_URL=<your-db>.turso.io

# Mode 5 (bonus): native pyturso engine, unrelated to Turso Cloud
# DATABASE_URL=sqlite+turso:///local_native.db
